# Momentum Trading Agent - Environment Configuration
# Copy to .env and fill in real values: cp .env.example .env

# Required for real market data (Technical Analyst).
# TradingView has no public historical-data API, so Alpha Vantage is the
# primary real-data source; Yahoo Finance (yfinance, no key needed) is used
# as a fallback if this is unset or fails, but is not always reachable
# depending on this environment's outbound network policy.
ALPHA_VANTAGE_API_KEY=

# Optional: only used if the coordinating LLM itself calls out to these
# providers beyond the bundled model. Not required for
# backtest_momentum_agent.py to run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- PHASE 1: Core price/execution (data_clients/) ---
# Primary Level 1 quotes, multi-timeframe OHLCV, SPX/SPY options chain
# + Greeks, and pre/post-market quotes. All four Phase 1 clients share
# this one key (Polygon covers all four endpoints used).
POLYGON_API_KEY=
# Fallback Level 1 quotes if Polygon is unset/down.
IEX_CLOUD_API_KEY=

# --- PHASE 2: Fundamental Analyst (real data, simulated path removed) ---
# Earnings calendar + surprise history. Reuses the key above (Alpha
# Vantage's EARNINGS endpoint) -- no separate key needed.
# (ALPHA_VANTAGE_API_KEY already declared above)
# Analyst consensus/price-targets + EPS/revenue estimate revisions.
FINNHUB_API_KEY=
# SEC EDGAR requires a descriptive User-Agent per their fair-use policy,
# not a secret key -- format: "Your Company Name contact@example.com"
SEC_EDGAR_USER_AGENT=

# --- PHASE 3: News Analyst (real headlines, simulated path removed) ---
# Real-time news wire (24h lookback), scored by a finance-tuned lexicon
# sentiment classifier (deterministic, no extra key needed for scoring).
NEWS_API_KEY=

# --- PHASE 4: Sentiment Analyst (combined social score, simulated path removed) ---
# Twitter/X cashtag ($TICKER) recent-search volume + sentiment.
TWITTER_BEARER_TOKEN=
# Reddit OAuth2 app-only (client-credentials) flow -- both required together.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# StockTwits symbol stream is a public, keyless API -- no key needed.

# --- PHASE 5: Macro Agent (new, dampener -- not a replacement) ---
# FRED (Federal Reserve Economic Data) for 2s10s yield curve, fed funds
# rate trend, and CPI/PCE/jobs releases. Free key from fred.stlouisfed.org.
# Note: FOMC-meeting-proximity suppression works with NO key at all --
# it's local calendar math against a maintained public schedule (see
# data_clients/macro_calendar.py); FRED only adds the yield-curve/rate/
# inflation dampening on top of that.
FRED_API_KEY=

# Backtest defaults (all overridable via CLI flags)
INITIAL_CAPITAL=500
TIME_PERIOD=1_week
NUM_BACKTESTS=5
SYMBOLS=AAPL,MSFT,GOOGL,AMZN,TSLA
