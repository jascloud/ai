      "comment": "Monitor top 10 markets on each platform, scan hourly"
    },

    "arbitrage_detection": {
      "min_spread_threshold_pct": 1.0,
      "min_liquidity_usd": 5000,
      "max_execution_slippage_pct": 1.0,
      "comment": "Only trade spreads > 1% with sufficient liquidity"
    },

    "position_sizing": {
      "method": "kelly_criterion",
      "kelly_fraction": 0.25,
      "max_position_size_pct": 15,
      "min_position_size_usd": 10,
      "comment": "Use 25% of full Kelly for arbs, cap at 15% of bankroll"
    },

    "fee_assumptions": {
      "polymarket_taker_pct": 2.0,
      "polymarket_maker_pct": 0.0,
      "kalshi_taker_pct": 2.0,
      "kalshi_maker_pct": 0.5,
      "estimated_total_cost_pct": 3.0,
      "comment": "Typical prediction market fees; verify on platforms"
    },

    "execution": {
      "mode": "analysis_only",
      "manual_execution": true,
      "automated_execution": false,
      "api_keys_required": false,
      "comment": "MVP is analysis. Execution requires Polymarket/Kalshi API keys"
    },

    "data_sources": {
      "polymarket_api": "https://clob.polymarket.com/markets",
